    <UserControl x:Class="MuseumClient.Views.ContentHubView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:MuseumClient.ViewModels"
                 xmlns:views="clr-namespace:MuseumClient.Views"
                 xmlns:vmDetails="clr-namespace:MuseumClient.ViewModels.Details"
                 xmlns:viewsDetails="clr-namespace:MuseumClient.Views.Details">

        <UserControl.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="2"
                        CornerRadius="8">

                            <ContentPresenter VerticalAlignment="Center"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Background" Value="Transparent"/>
                                </MultiTrigger.Conditions>

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#22FFFFFF"/>
                            </MultiTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                Property="Background"
                                Value="#44FFFFFF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplates -->

        <DataTemplate DataType="{x:Type vm:AboutMuseumViewModel}">
            <views:AboutMuseumView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ArticlesViewModel}">
            <views:ArticlesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExhibitsViewModel}">
            <views:ExhibitsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
            <views:DepartmentsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MediaImagesViewModel}">
            <views:MediaImagesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MediaVideosViewModel}">
            <views:MediaVideosView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:IllustrationViewModel}">
            <viewsDetails:IllustrationView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:DocumentViewerViewModel}">
            <viewsDetails:DocumentViewerView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:ExhibitViewerViewModel}">
            <viewsDetails:ExhibitViewerView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:AddExhibitViewModel}">
            <viewsDetails:AddExhibitView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:VideoViewerViewModel}">
            <viewsDetails:VideoViewerView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:DepartmentCatalogViewModel}">
            <viewsDetails:DepartmentCatalogView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:AddArticleViewModel}">
            <viewsDetails:AddArticleView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmDetails:AddDepartmentViewModel}">
            <viewsDetails:AddDepartmentView/>
        </DataTemplate>
            
        <DataTemplate DataType="{x:Type vmDetails:AddImageViewModel}">
            <viewsDetails:AddImageView/>
        </DataTemplate>
            
        <DataTemplate DataType="{x:Type vmDetails:AddVideoViewModel}">
            <viewsDetails:AddVideoView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

    </UserControl.Resources>

        <Grid Background="White">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->

            <Border Grid.Column="0"
                    Background="#4A90E2"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0">

                <DockPanel>

                    <!-- Выход -->

                    <Button DockPanel.Dock="Bottom"
                            Content="Выйти"
                            HorizontalContentAlignment="Center"
                            FontSize="18"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="10, 15"/>

                    <StackPanel>

                        <!-- Шапка -->

                        <Border Margin="15"
                                Padding="10"
                                Background="White"
                                CornerRadius="12">

                            <StackPanel>

                                <TextBlock Text="🏛"
                                           FontSize="36"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Память времён"
                                           FontWeight="Bold"
                                           FontSize="20"
                                           Foreground="#1F2937"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Школьный музей"
                                           Foreground="#6B7280"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    <Border Background="#EEF2FF"
                        CornerRadius="8"
                        Padding="6"
                        Margin="10,0,10,10">

                        <TextBlock Text="{Binding CurrentUserTypeDisplay}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1D4ED8"
                           HorizontalAlignment="Center"/>
                    </Border>

                    <Button Content="🏠  О музее"
                            Command="{Binding ShowAboutMuseumCommand}">

                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButtonStyle}"
                                   TargetType="Button">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMenu}"
                                                Value="About">
                                        <Setter Property="Background"
                                                Value="#4A70FF"/>
                                        <Setter Property="Foreground"
                                                Value="#EEF2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <Button Content="📰  Статьи"
                            Command="{Binding ShowArticlesCommand}">

                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButtonStyle}"
                                   TargetType="Button">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMenu}"
                                                 Value="Articles">
                                        <Setter Property="Background"
                                                Value="#4A70FF"/>
                                        <Setter Property="Foreground"
                                                Value="#EEF2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                    </Button>

                    <Button Content="🏺  Экспонаты"
                            Command="{Binding ShowExhibitsCommand}">
                        <Button.Style>
                        <Style BasedOn="{StaticResource SidebarButtonStyle}"
                                   TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMenu}"
                                             Value="Exhibits">
                                    <Setter Property="Background"
                                            Value="#4A70FF"/>
                                    <Setter Property="Foreground"
                                            Value="#EEF2FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🏢  Отделы"
                                Command="{Binding ShowDepartmentsCommand}">
                        <Button.Style>
                        <Style BasedOn="{StaticResource SidebarButtonStyle}"
                               TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMenu}"
                                            Value="Departments">
                                    <Setter Property="Background"
                                            Value="#4A70FF"/>
                                    <Setter Property="Foreground"
                                            Value="#EEF2FF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🖼  Иллюстрации"
                                Command="{Binding ShowIllustrationsCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButtonStyle}"
                               TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMenu}"
                                            Value="Illustrations">
                                        <Setter Property="Background"
                                            Value="#4A70FF"/>
                                        <Setter Property="Foreground"
                                            Value="#EEF2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🎥  Видео"
                                Command="{Binding ShowVideosCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButtonStyle}"
                               TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMenu}"
                                            Value="Videos">
                                        <Setter Property="Background"
                                            Value="#4A70FF"/>
                                        <Setter Property="Foreground"
                                            Value="#EEF2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="⚙  Настройки"
                            Command="{Binding ShowSettingsCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SidebarButtonStyle}"
                                   TargetType="Button">

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMenu}"
                                                 Value="Settings">

                                        <Setter Property="Background"
                                                Value="#4A70FF"/>

                                        <Setter Property="Foreground"
                                                Value="#EEF2FF"/>

                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>

                </DockPanel>

            </Border>

            <!-- Контент -->

            <Border Grid.Column="1"
                    Margin="20"
                    Background="White"
                    CornerRadius="16">

                <ContentControl Content="{Binding CurrentTabView}"/>

            </Border>

        </Grid>

    </UserControl>