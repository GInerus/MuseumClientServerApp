<UserControl x:Class="MuseumClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:MuseumClient.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Стиль карточки-кнопки в меню настроек -->
        <Style x:Key="SettingsCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка "Назад" -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
               Text="Настройки"
               FontSize="22"
               FontWeight="Bold"
               Foreground="#1F2937"
               Margin="20,20,20,10"/>

        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="20"
          HorizontalAlignment="Stretch">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- ========================= -->
                <!-- ГЛАВНОЕ МЕНЮ -->
                <!-- ========================= -->

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Menu">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 🔒 Смена пароля (только админ) -->
                    <Button Style="{StaticResource SettingsCardButtonStyle}"
                            Margin="0,0,0,12"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Password"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🔒 Смена пароля" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="Изменить пароль администратора" Foreground="#6B7280" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 📜 Журнал действий (только админ, пока заглушка) -->
                    <Button Style="{StaticResource SettingsCardButtonStyle}"
                            Margin="0,0,0,12"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Log"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📜 Журнал действий" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="История изменений в системе" Foreground="#6B7280" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 🖥 Информация о системе (видно всем) -->
                    <Button Style="{StaticResource SettingsCardButtonStyle}"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="System">
                        <StackPanel>
                            <TextBlock Text="🖥 Информация о системе" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>
                            <TextBlock Text="Версии клиента и сервера" Foreground="#6B7280" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- ========================= -->
                <!-- СМЕНА ПАРОЛЯ -->
                <!-- ========================= -->

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Password">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="← Назад"
                            Style="{StaticResource BackButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"
                            Command="{Binding BackToMenuCommand}"/>

                    <Border Background="White"
                            CornerRadius="16"
                            Padding="20"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2">

                        <StackPanel>

                            <TextBlock Text="🔒 Смена пароля администратора"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Текущий пароль" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

                            <PasswordBox x:Name="OldPasswordBox"
                                         Height="36"
                                         Margin="0,0,0,15"
                                         PasswordChanged="OldPasswordBox_PasswordChanged"/>

                            <TextBlock Text="Новый пароль" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

                            <PasswordBox x:Name="NewPasswordBox"
                                         Height="36"
                                         Margin="0,0,0,15"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"/>

                            <TextBlock Text="Подтверждение нового пароля" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>

                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Height="36"
                                         Margin="0,0,0,20"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                            <Button Content="Сохранить"
                                    Width="160"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    Background="#4A90E2"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Command="{Binding ChangePasswordCommand}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- ========================= -->
                <!-- ЖУРНАЛ ДЕЙСТВИЙ (заглушка) -->
                <!-- ========================= -->

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="Log">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="← Назад"
                            Style="{StaticResource BackButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"
                            Command="{Binding BackToMenuCommand}"/>

                    <Border Background="White"
                            CornerRadius="16"
                            Padding="30"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2">

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🚧" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Журнал действий в разработке"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="Здесь появится история действий администраторов: создание, редактирование и удаление объектов."
                                       Foreground="#6B7280"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"
                                       MaxWidth="360"/>
                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- ========================= -->
                <!-- ИНФОРМАЦИЯ О СИСТЕМЕ -->
                <!-- ========================= -->

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="System">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="← Назад"
                            Style="{StaticResource BackButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,15"
                            Command="{Binding BackToMenuCommand}"/>

                    <Border Background="White"
                            CornerRadius="16"
                            Padding="20"
                            BorderBrush="#E5E7EB"
                            BorderThickness="2">

                        <StackPanel>

                            <TextBlock Text="🖥 Информация о системе"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Клиент" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" Text="{Binding ClientVersion}" Foreground="#6B7280"/>
                            </Grid>

                            <Separator Margin="0,5"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сервер" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock Grid.Column="1" Text="{Binding ServerVersion}" Foreground="#6B7280"/>
                            </Grid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </ScrollViewer>

        <!-- ОВЕРЛЕЙ СОХРАНЕНИЯ -->
        <Grid Panel.ZIndex="999"
              Background="#66000000"
              Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}">

            <Border Width="220"
                    Height="100"
                    Background="#1F2937"
                    CornerRadius="16"
                    Opacity="0.95"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Width="150" Height="8" IsIndeterminate="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Сохранение..." Foreground="White" FontSize="13" TextAlignment="Center"/>
                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
